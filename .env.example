# Neon Postgres (serverless). Copia esta línea en Vercel → Settings → Environment Variables.
# Usa la cadena "pooled" de Neon para runtime serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/haciendas?sslmode=require"

# Conexión directa (sin pooler) para migraciones de Prisma. Opcional pero recomendado.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/haciendas?sslmode=require"

# Secreto para firmar las sesiones (JWT). Genera uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
